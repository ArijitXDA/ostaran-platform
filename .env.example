# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ============================================
# SUPABASE CONFIGURATION
# ============================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# VDOCIPHER (Video Hosting)
# ============================================
VDOCIPHER_API_KEY=your_vdocipher_api_key
VDOCIPHER_CLIENT_ID=your_vdocipher_client_id

# ============================================
# RAZORPAY (Payment Gateway)
# ============================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ============================================
# MAKE.COM (Email Automation)
# ============================================
MAKE_WEBHOOK_URL=your_make_webhook_url
MAKE_API_KEY=your_make_api_key

# ============================================
# OPENAI (AI Agent)
# ============================================
OPENAI_API_KEY=your_openai_api_key
OPENAI_ORG_ID=your_openai_org_id

# ============================================
# GROK (AI Agent)
# ============================================
GROK_API_KEY=your_grok_api_key

# ============================================
# AWS S3 (Course Materials Storage)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region
AWS_S3_BUCKET=your_s3_bucket_name

# ============================================
# ONEDRIVE (Alternative Storage)
# ============================================
ONEDRIVE_CLIENT_ID=your_onedrive_client_id
ONEDRIVE_CLIENT_SECRET=your_onedrive_client_secret
ONEDRIVE_TENANT_ID=your_onedrive_tenant_id

# ============================================
# PINECONE (Vector Database)
# ============================================
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=your_pinecone_index_name

# ============================================
# REDIS (Alternative Vector Database)
# ============================================
REDIS_URL=your_redis_url
REDIS_TOKEN=your_redis_token

# ============================================
# APPLICATION SETTINGS
# ============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
